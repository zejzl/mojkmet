generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CONSUMER
  FARMER
  ADMIN
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  ACCEPTED
  READY
  COLLECTED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PickupChangeRequestedBy {
  FARMER
  CONSUMER
}

enum PickupChangeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FarmPlan {
  TRIAL
  STANDARD
  PREMIUM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          UserRole  @default(CONSUMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  farm          Farm?
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Farm {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  description String?
  address     String
  city        String
  postalCode  String
  latitude    Float?
  longitude   Float?
  phone       String?
  website     String?
  image       String?
  minOrder    Decimal? @db.Decimal(10, 2)
  verified    Boolean  @default(false)
  plan        FarmPlan @default(TRIAL)
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  reviews       Review[]
  orders        Order[]
  pickupWindows PickupWindow[]

  @@map("farms")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  icon     String?
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  farmId      String
  categoryId  String
  name        String
  description String?
  price       Float
  unit        String   @default("kg")
  stock       Int      @default(0)
  available   Boolean  @default(true)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm       Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  favorites  Favorite[]

  @@map("products")
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  farmId          String
  status          OrderStatus   @default(AWAITING_PAYMENT)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  platformFee     Decimal       @db.Decimal(10, 2)
  payoutAmount    Decimal       @db.Decimal(10, 2)
  paymentProvider String?
  paymentRef      String?
  invoiceNumber   String?
  invoicePdfUrl   String?
  paidAt          DateTime?
  pickupStartsAt  DateTime
  pickupEndsAt    DateTime
  reservedUntil   DateTime?
  phone           String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  farm          Farm          @relation(fields: [farmId], references: [id])
  items         OrderItem[]
  pickupChanges PickupChange[]

  @@index([userId])
  @@index([farmId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  farmId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model PickupWindow {
  id        String   @id @default(cuid())
  farmId    String
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("pickup_windows")
}

model PickupChange {
  id            String                @id @default(cuid())
  orderId       String
  requestedBy   PickupChangeRequestedBy
  currentStart  DateTime
  currentEnd    DateTime
  proposedStart DateTime
  proposedEnd   DateTime
  reason        String?
  status        PickupChangeStatus    @default(PROPOSED)
  createdAt     DateTime              @default(now())
  respondedAt   DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pickup_changes")
}

model PaymentEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  type       String
  payload    Json?
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
  @@map("payment_events")
}